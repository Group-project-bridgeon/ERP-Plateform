POSTGRES_ADMIN_USER=erp_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_password
POSTGRES_PORT=5432

AUTH_DB_PASSWORD=change_me_auth_password
CATALOG_DB_PASSWORD=change_me_catalog_password
PARTY_DB_PASSWORD=change_me_party_password
PURCHASING_DB_PASSWORD=change_me_purchasing_password
INVENTORY_DB_PASSWORD=change_me_inventory_password
# Inventory runtime and migrate pass this raw password through PGPASSWORD;
# do not URI-encode it. Existing database role passwords are not changed by .env.
SALES_DB_PASSWORD=change_me_sales_password
RETURNS_DB_PASSWORD=change_me_returns_password
FINANCE_DB_PASSWORD=change_me_finance_password
REPORTING_DB_PASSWORD=change_me_reporting_password
NOTIFICATION_DB_PASSWORD=change_me_notification_password

# Catalog Service runtime tuning

CATALOG_DB_MAX_CONNS=10
CATALOG_DB_MIN_CONNS=2
CATALOG_DB_MAX_CONN_LIFETIME=30m
CATALOG_DB_MAX_CONN_IDLE_TIME=5m
CATALOG_DB_HEALTH_CHECK_PERIOD=1m
CATALOG_DB_STATEMENT_TIMEOUT=5s

CATALOG_HTTP_MAX_BODY_BYTES=1048576
CATALOG_HTTP_SLOW_REQUEST_THRESHOLD=500ms

CATALOG_REFERENCE_CACHE_TTL=45s

# Authentication Service

AUTH_APP_ENV=development
AUTH_JWT_ISSUER=erp-auth
AUTH_JWT_AUDIENCE=erp-api
AUTH_JWT_EXPIRY=15m

AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=http://localhost:8000/api/v1/auth/google/callback

AUTH_SMTP_HOST=mock
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=noreply@example.com
AUTH_SMTP_FROM_NAME=Authentication Service

# Catalog shares AUTH_JWT_ISSUER/AUTH_JWT_AUDIENCE above.
# Mount ../Authentication/keys/jwt-public.pem; never mount the private key here.
# Optional docker-compose.catalog-dev.yml only:
CATALOG_DEV_PORT=8081
